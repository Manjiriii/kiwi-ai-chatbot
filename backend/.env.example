# Hugging Face API Token (Enter your token from https://huggingface.co/settings/tokens)
HF_TOKEN=

# Default Model: meta-llama/Meta-Llama-3-70B-Instruct
HF_MODEL=meta-llama/Meta-Llama-3-70B-Instruct

# Free AI Providers (Optional - recommended for 100% free LLaMA 3 70B inference):
# 1. Groq (Free tier with ultra-fast LLaMA 3.3 70B - get free key at https://console.groq.com)
GROQ_API_KEY=

# 2. OpenRouter (Free models ending in :free - get key at https://openrouter.ai)
OPENROUTER_API_KEY=

# Server Configuration
HOST=0.0.0.0
PORT=8000
